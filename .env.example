# ============================================================================
# BLIMBLOOM — Environment Configuration Template (For Cloud & Frontend Teams)
# ============================================================================
# How to use:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in the values below from Firebase Console & Google Cloud Run.
#   3. Sync the .env values into public/js/config.js automatically:
#        npm run env:sync
#
# SECURITY WARNING:
#   - NEVER put GEMINI_API_KEY in public/js/config.js or any frontend file.
#   - GEMINI_API_KEY is used ONLY inside Google Cloud Secret Manager for Cloud Run.
# ============================================================================

# --- 1. Cloud Run Backend Endpoint (No trailing slash) ---
# Obtained after running `gcloud run deploy blimblom-api --region asia-southeast1 ...`
CLOUD_RUN_URL=https://blimblom-api-xxxxx-as.a.run.app

# --- 2. Firebase Web App Config (Firebase Console -> Project Settings -> General) ---
FIREBASE_API_KEY=TODO_INSERT_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=TODO_INSERT_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=TODO_INSERT_PROJECT_ID
FIREBASE_STORAGE_BUCKET=TODO_INSERT_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=TODO_INSERT_MESSAGING_SENDER_ID
FIREBASE_APP_ID=TODO_INSERT_APP_ID

# --- 3. Firebase Cloud Messaging Web Push Certificate (VAPID Key) ---
# Obtained from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
FIREBASE_VAPID_KEY=TODO_INSERT_VAPID_PUBLIC_KEY

# ============================================================================
# (Reference Only) Cloud Run Backend Environment Variables (For Role C / Cloud)
# ============================================================================
GCP_PROJECT_ID=blimblom
GCP_REGION=asia-southeast1
GEMINI_MODEL=gemini-2.5-flash
PORT=8080
